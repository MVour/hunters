# board2D, mode "behind-proxy": the server already has a front door (its own
# Caddy or nginx) that does HTTPS for DOMAIN and forwards to this container,
# published on 127.0.0.1 only (setup-server.sh writes the compose override).
# Plain HTTP inside; no certificates here. Site rules: site.caddy.
{
	admin off
	auto_https off
	servers {
		# The front door reaches us through Docker's bridge (a private
		# address); trust its X-Forwarded-For so {client_ip} is the player.
		trusted_proxies static private_ranges
	}
}

:80 {
	import /etc/caddy/site.caddy
}

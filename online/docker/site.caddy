# board2D site rules, shared by both front-door modes:
#   Caddyfile                - this Caddy is the front door (HTTPS, port 80/443)
#   behind-proxy.Caddyfile   - the server's own Caddy/nginx does HTTPS and
#                              forwards to this one on 127.0.0.1 (plain HTTP)
# DOMAIN comes from the environment (online/deploy/.env).

encode zstd gzip

header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "no-referrer"
	X-Frame-Options "DENY"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Cross-Origin-Opener-Policy "same-origin"
	-Server
}

# API and game connections: to the lobby service (never logged here:
# /play URLs carry single-use tickets). X-Forwarded-For is replaced by the
# one real client address (behind a proxy: the address the proxy saw), so the
# service's per-IP limits count players, not the proxy.
@service path /api/* /play/*
handle @service {
	request_body {
		max_size 16KB
	}
	reverse_proxy lobby:8787 {
		header_up X-Forwarded-For {client_ip}
	}
}

# The desktop game to download (Windows zip, built with every release).
# Always saved as a file, never shown or run in the page.
handle_path /download/* {
	root * /srv/download
	header Content-Disposition "attachment"
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
	header Cache-Control "no-cache"
	file_server
}

# The browser game (Godot web export). Godot's page needs inline/eval
# script and WebAssembly; it may only connect back to this site.
redir /game /game/ 308
handle_path /game/* {
	root * /srv/game
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' wss://{$DOMAIN}; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
	header Cache-Control "no-cache"
	file_server
}

# The lobby page (Vue): strict policy, no inline scripts at all.
handle {
	root * /srv/lobby
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# /opt/board2d/.env on the server (setup-server.sh writes it; chmod 600).
# The domain players open; its A record must point at this server's IP.
DOMAIN=play.example.com
# For Let's Encrypt notices about the certificate (never shown to players).
ACME_EMAIL=you@example.com
# Signs login cookies. 64 random hex chars: openssl rand -hex 32
SESSION_SECRET=
# Where the images come from (set by the GitHub workflow on deploy).
IMAGE_PREFIX=ghcr.io/your-github-name
IMAGE_TAG=latest
# Resources for all rooms together.
LOBBY_MEMORY=1536m
LOBBY_CPUS=2
